{
  "name": "docwarden-workspace",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "description": "Workspace for docwarden workflow, contexta infra, and isomorph semantic runtime CLIs",
  "license": "MIT",
  "bin": {
    "docwarden": "apps/docwarden/dist/index.js",
    "contexta": "apps/contexta/dist/index.js",
    "isomorph": "apps/isomorph/dist/index.js"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "build": "turbo run build",
    "build:contexta": "pnpm --filter contexta build",
    "build:isomorph": "pnpm --filter isomorph build",
    "build:docwarden": "pnpm --filter docwarden build",
    "clean": "turbo run clean",
    "deps:check": "taze -r",
    "deps:check:all": "taze -r --all",
    "deps:fresh": "taze minor -r -w -i --maturity-period 7",
    "dev": "turbo run dev",
    "effect:patch": "effect-tsgo patch",
    "effect:source:verify": "node scripts/verify-effect-source.mjs",
    "effect:unpatch": "effect-tsgo unpatch",
    "husky:install": "husky",
    "knip": "knip",
    "link": "pnpm build:docwarden && pnpm build:isomorph && pnpm build:contexta && pnpm link",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "outdated": "pnpm outdated -r",
    "prepare": "node -e \"if (require('node:fs').existsSync('.git')) require('node:child_process').execFileSync('husky', { stdio: 'inherit', shell: true })\" && effect-tsgo patch",
    "smoke:bin": "pnpm --filter docwarden smoke:bin && pnpm --filter contexta smoke:bin && pnpm --filter isomorph smoke:bin",
    "test": "vitest run --config packages/vitest-config/workspace.config.ts",
    "typecheck": "turbo run typecheck",
    "typecheck:tsc": "turbo run typecheck:tsc",
    "unlink": "pnpm rm -g docwarden-workspace",
    "verify": "pnpm build && pnpm typecheck && pnpm test && pnpm lint && pnpm knip && pnpm effect:source:verify",
    "verify:code": "pnpm build && pnpm typecheck && pnpm test && pnpm lint && pnpm knip && pnpm effect:source:verify"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@docwarden/tsdown-config": "workspace:*",
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "taze": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
